# ==============================================================================
# Variables de entorno - Backend FastAPI (Tekio Electronics)
# ==============================================================================

# Entorno: desarrollo | produccion
ENTORNO=produccion

# PostgreSQL (Vercel Postgres / Neon / Supabase / VPS)
# Acepta POSTGRES_URL o URL_BASE_DATOS (se normaliza automáticamente a postgresql+psycopg://)
POSTGRES_URL=postgresql://usuario:clave@host.neon.tech/tekio_admin?sslmode=require
URL_BASE_DATOS=

# Secreto JWT (generar mínimo 32 caracteres aleatorios en producción)
JWT_SECRET=reemplazar_por_secreto_seguro_de_al_menos_32_caracteres
EXPIRACION_JWT_HORAS=12

# Orígenes CORS permitidos (separados por comas, sin barra final)
CORS_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:3000

# Zona horaria oficial de Venezuela (UTC-4)
ZONA_HORARIA=America/Caracas
