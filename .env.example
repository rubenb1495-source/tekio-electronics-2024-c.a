# ==============================================================================
# Variables de entorno - Sistema Administrativo Tekio Electronics
# Copia este archivo como .env y completa los valores correspondientes.
# ==============================================================================

# --- Base de datos PostgreSQL (Vercel Postgres / Neon / VPS) ---
# Si se deja vacío en desarrollo local, el backend usa SQLite en backend-python/datos/tekio_desarrollo.db
URL_BASE_DATOS=
POSTGRES_URL=

# --- Seguridad JWT (obligatorio cambiar en producción) ---
SECRETO_JWT=cambiar_por_secreto_largo_y_aleatorio
EXPIRACION_JWT_HORAS=12

# --- CORS (separado por comas) ---
ORIGENES_CORS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Next.js ---
NEXT_PUBLIC_URL_API_PYTHON=http://localhost:8000
